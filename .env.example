# Required.
CURSOR_API_KEY=<your Cursor API key>
# Optional.The model ID of the Cursor model to use for eval. To list models,
# run `cursor-agent --list-models`Defaults to the IDE current model.
SPECIFY_EVAL_MODEL=<Cursor model ID>
# The timeout in seconds for Cursor API calls. Defaults to 120 which might not
# be enough for mid-level models like composer-2.5.
SPECIFY_EVAL_TIMEOUT_SECS=<timeout in seconds for Cursor API calls>
