# Required.
CURSOR_API_KEY=<your Cursor API key>
# Optional. The model ID of the Cursor model to use for eval. To list models,
# run `cursor-agent --list-models`. Defaults to the IDE current model.
EVAL_MODEL=<Cursor model ID>
# Optional. Per-spawn cursor-agent wall-clock timeout in seconds. Unset → 120
# from the cursor backend; `cargo make eval` defaults this to 300 (enough for
# mid-tier models like composer-2.5). Override here to change that default.
EVAL_TIMEOUT_SECS=<u64 seconds>
