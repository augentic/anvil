# --- Backend selection ---------------------------------------------------
# Optional. Which spawned agent CLI serves model completions: `cursor`
# (default) or `claude`. Only the selected backend is connected, so each mode
# needs only its own binary on PATH. An unrecognised value is an error rather
# than a silent fall back to the default.
EMERY_MODEL_BACKEND=cursor

# --- Transport retry (both backends) -------------------------------------
# Optional. Extra attempts after a transport failure — an unreachable
# provider, a killed spawn, a stalled stream. Unset → 2. A rejected answer is
# never retried here; the backend's own two-attempt format repair covers that.
EMERY_MODEL_RETRIES=<u32 attempts>
# Optional. Wait before the first retry, doubling for each one after, with
# jitter. Unset → 1000.
EMERY_MODEL_RETRY_BACKOFF_MS=<u64 milliseconds>

# --- cursor-agent backend (EMERY_MODEL_BACKEND=cursor) -------------------
# Required for this backend.
CURSOR_API_KEY=<your Cursor API key>
# Optional. Default model when a request leaves model unset. To list models,
# run `cursor-agent --list-models`. Blank/unset lets cursor-agent choose.
CURSOR_MODEL=<Cursor model ID>
# Optional. Per-spawn cursor-agent wall-clock timeout in seconds. Unset → 600
# from the cursor backend; `cargo make eval` defaults this to 300 (enough for
# mid-tier models like composer-2.5). Override here to change that default.
CURSOR_TIMEOUT_SECS=<u64 seconds>
# Optional. Kill a spawn after this long with no stream events, so a stalled
# agent dies well before the absolute cap. Unset → 120.
CURSOR_INACTIVITY_SECS=<u64 seconds>

# --- Claude Code backend (EMERY_MODEL_BACKEND=claude) --------------------
# Required for this backend unless the CLI already holds a `claude login`.
ANTHROPIC_API_KEY=<your Anthropic API key>
# Optional. Default model when a request leaves model unset; blank/unset lets
# the claude CLI choose.
CLAUDE_MODEL=<Claude model ID>
# Optional. Per-spawn claude wall-clock timeout in seconds. Unset → 600.
CLAUDE_TIMEOUT_SECS=<u64 seconds>
# Optional. Kill a spawn after this long with no stream events. Unset → 120.
CLAUDE_INACTIVITY_SECS=<u64 seconds>
# Optional. Pass `--bare`, forcing ANTHROPIC_API_KEY and ignoring the CLI's
# stored OAuth/subscription login. Unset → off, which uses whichever
# credential the CLI already has.
CLAUDE_BARE=1
