/// The host-owned executable-mode capability. Exists solely because
/// `wasi:filesystem` (through 0.3.0) carries no permission bits: an
/// in-guest snapshot walk or materialization over the filesystem
/// preopens would silently lose the executable bit — the one mode
/// distinction the snapshot manifest round-trips (`100755` vs
/// `100644`). Deletes if upstream permission bits ever land in Omnia's
/// filesystem host. Imported by the workflow guest only.
package emery:exec-mode@0.1.0;

interface types {
  /// The error returned by exec-mode operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }
}

interface exec-mode {
  use types.{ error };

  /// The `/`-separated relative paths of executable regular files
  /// beneath `root` — a deployment-local tree root: `.` (the project
  /// tree), a workspace root beneath the deployment's workspaces
  /// mount, or a staged VCS tree beneath the staging mount. Never
  /// follows symlinks; ignored paths (`.git`, `.emery/change`) may be
  /// skipped.
  read: async func(root: string) -> result<list<string>, error>;

  /// Round-trip the manifest's mode distinction onto a materialized
  /// tree: set the executable bit (0o755) on `exec` and clear it
  /// (0o644) on `plain`, each `/`-separated relative to `root`.
  apply: async func(root: string, exec: list<string>, plain: list<string>) -> result<_, error>;
}

/// Host-side bindgen world. Never exported by a guest.
world imports {
  import exec-mode;
}
