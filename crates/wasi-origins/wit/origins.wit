/// The host-owned origin-fetch capability. The engine guest has no
/// network or git: survey materializes remote coverage locators
/// (Git or HTTPS) through the host, which fetches into a
/// deployment-local tree beneath the workspaces mount. Private Git
/// uses ambient host credentials; no secrets surface in the
/// definition home. Imported by the workflow guest only.
package emery:origins@0.1.0;

interface types {
  /// The error returned by origin operations.
  variant error {
    /// The locator is not a fetchable origin.
    invalid-request(string),
    /// The origin refused or could not be reached.
    access(string),
    internal(string),
  }
}

interface origins {
  use types.{ error };

  /// One fetched origin: the deployment-local tree plus the origin's
  /// revision report.
  record fetched {
    /// Deployment-local root of the fetched tree, beneath the
    /// deployment's workspaces mount. The caller snapshots it and
    /// then discards it.
    root: string,
    /// The commit the fetch reports, when the origin is Git.
    revision: option<string>,
  }

  /// Fetch a remote origin locator into a deployment-local tree: a
  /// Git origin clones (ambient host credentials), any other HTTPS
  /// locator downloads as a one-file tree.
  fetch: async func(locator: string) -> result<fetched, error>;

  /// Discard a fetched tree by its deployment-local root.
  /// Best-effort and idempotent.
  discard: async func(root: string) -> result<_, error>;
}

/// Host-side bindgen world for the `origins` capability: the shipped
/// runtime links a host implementation of this interface into the
/// engine deployment. Never exported by a guest.
world origins-host {
  import origins;
}
