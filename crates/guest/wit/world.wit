/// The engine guest's private bindgen world over the vendored
/// `wasi:blobstore` package (see README.md). Emery-named so its
/// encoded-world custom section never collides with the identically
/// named world Omnia's blobstore guest bindings embed — the linker
/// concatenates same-named custom sections, corrupting both.
package emery:blob-client;

world snapshots {
  import wasi:blobstore/types@0.2.0-draft;
  import wasi:blobstore/container@0.2.0-draft;
  import wasi:blobstore/blobstore@0.2.0-draft;
}
