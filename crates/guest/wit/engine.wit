/// The `emery:engine` package: the engine guest's own world, split from
/// the published `emery:adapter` contract so host-seam changes never
/// drag the adapter release train. Adapters never vendor this package.
package emery:engine@0.1.0;

/// The engine guest: the deployment's only `wasi:cli/run` exporter.
/// The `source` import routes to adapter guests by `adapter-id`.
world workflow {
  import emery:adapter/source@0.1.0;
}
