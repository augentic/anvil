{
  "$defs": {
    "ClaimRef": {
      "additionalProperties": false,
      "description": "One claim reference into persisted Evidence.",
      "properties": {
        "id": {
          "description": "Claim id within that source's Evidence.",
          "type": "string"
        },
        "source": {
          "description": "Coverage-row source key.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "type": "object"
    },
    "DeliveryMapping": {
      "additionalProperties": false,
      "description": "One reviewed source-to-target assignment.",
      "properties": {
        "lead": {
          "description": "The surveyed lead id.",
          "type": "string"
        },
        "source": {
          "description": "Coverage-row source key.",
          "type": "string"
        },
        "target": {
          "description": "A `targets[]` id in the same wave.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "lead",
        "target"
      ],
      "type": "object"
    },
    "Disposition": {
      "additionalProperties": false,
      "description": "One reviewed modernization disposition (RFC-104 D7).",
      "properties": {
        "applies-to": {
          "description": "Element or relationship ids the disposition covers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable disposition id, unique across the file.",
          "type": "string"
        },
        "reason": {
          "description": "The reviewed reason (desired outcome and authority for\n`change`; the insufficiency for `investigate`).",
          "type": "string"
        },
        "treatment": {
          "$ref": "#/$defs/Treatment",
          "description": "The reviewed treatment."
        }
      },
      "required": [
        "id",
        "treatment",
        "reason"
      ],
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "description": "One model element.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Open attribute map (D6 state and temporal facts live here).",
          "type": "object"
        },
        "claims": {
          "default": [],
          "description": "Claim refs into persisted Evidence.",
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "type": "array"
        },
        "context-only": {
          "default": false,
          "description": "Relevant to the migration without being modified by it.",
          "type": "boolean"
        },
        "decision": {
          "description": "The `decisions/<id>.yaml` record behind `status: decided`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable element id, unique across the state.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind",
          "description": "Closed element vocabulary."
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Epistemic status of this record."
        }
      },
      "required": [
        "id",
        "kind",
        "status"
      ],
      "type": "object"
    },
    "ElementKind": {
      "description": "Closed element vocabulary (RFC-104 D4).",
      "oneOf": [
        {
          "const": "system",
          "description": "A whole system within or beside the boundary.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "A service or component.",
          "type": "string"
        },
        {
          "const": "repository",
          "description": "A source repository.",
          "type": "string"
        },
        {
          "const": "interface",
          "description": "An exposed interface (API, UI, file feed).",
          "type": "string"
        },
        {
          "const": "data-store",
          "description": "A data store.",
          "type": "string"
        },
        {
          "const": "queue",
          "description": "A queue or topic.",
          "type": "string"
        },
        {
          "const": "scheduled-job",
          "description": "A scheduled job.",
          "type": "string"
        },
        {
          "const": "deployment-unit",
          "description": "A deployment unit.",
          "type": "string"
        },
        {
          "const": "environment",
          "description": "A runtime environment.",
          "type": "string"
        },
        {
          "const": "external-actor",
          "description": "An external actor or system.",
          "type": "string"
        },
        {
          "const": "owning-group",
          "description": "An owning group.",
          "type": "string"
        }
      ]
    },
    "EvidenceScope": {
      "additionalProperties": false,
      "description": "One selected estate-survey lead.",
      "properties": {
        "lead": {
          "description": "The surveyed lead id.",
          "type": "string"
        },
        "source": {
          "description": "Coverage-row source key.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "lead"
      ],
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "description": "One inlined wave sub-record: a stable id plus its reviewed detail.",
      "properties": {
        "detail": {
          "description": "The reviewed detail.",
          "type": "string"
        },
        "id": {
          "description": "Stable sub-record id, unique within its list.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "detail"
      ],
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "description": "One model relationship.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Open attribute map.",
          "type": "object"
        },
        "claims": {
          "default": [],
          "description": "Claim refs into persisted Evidence.",
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "type": "array"
        },
        "context-only": {
          "default": false,
          "description": "Relevant to the migration without being modified by it.",
          "type": "boolean"
        },
        "decision": {
          "description": "The `decisions/<id>.yaml` record behind `status: decided`.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "Source element id.",
          "type": "string"
        },
        "id": {
          "description": "Stable relationship id, unique across the state.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationshipKind",
          "description": "Closed relationship vocabulary."
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Epistemic status of this record."
        },
        "to": {
          "description": "Destination element id.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "status"
      ],
      "type": "object"
    },
    "RelationshipKind": {
      "description": "Closed relationship vocabulary (RFC-104 D4).",
      "oneOf": [
        {
          "const": "containment",
          "description": "`from` contains `to`.",
          "type": "string"
        },
        {
          "const": "deployment",
          "description": "`from` is deployed onto `to`.",
          "type": "string"
        },
        {
          "const": "invocation",
          "description": "`from` invokes `to`.",
          "type": "string"
        },
        {
          "const": "publication",
          "description": "`from` publishes to `to`.",
          "type": "string"
        },
        {
          "const": "consumption",
          "description": "`from` consumes from `to`.",
          "type": "string"
        },
        {
          "const": "read",
          "description": "`from` reads `to`.",
          "type": "string"
        },
        {
          "const": "write",
          "description": "`from` writes `to`.",
          "type": "string"
        },
        {
          "const": "dependency",
          "description": "`from` depends on `to`.",
          "type": "string"
        },
        {
          "const": "ownership",
          "description": "`from` owns `to`.",
          "type": "string"
        }
      ]
    },
    "ResponseKind": {
      "description": "Proposal response envelope kind.",
      "oneOf": [
        {
          "const": "response",
          "description": "The agent's proposal.",
          "type": "string"
        }
      ]
    },
    "State": {
      "additionalProperties": false,
      "description": "One named architecture state.",
      "properties": {
        "elements": {
          "default": [],
          "description": "Stable elements, in model order.",
          "items": {
            "$ref": "#/$defs/Element"
          },
          "type": "array"
        },
        "relationships": {
          "default": [],
          "description": "Relationships between element ids.",
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Status": {
      "description": "Closed epistemic status set.",
      "oneOf": [
        {
          "const": "evidenced",
          "description": "Backed by at least one persisted claim.",
          "type": "string"
        },
        {
          "const": "inferred",
          "description": "Model inference with no claims; repetition never promotes it.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Disagreeing claims are retained, none wins.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "An explicit gap with no claims.",
          "type": "string"
        },
        {
          "const": "decided",
          "description": "Settled by a `decisions/<id>.yaml` record (persist-tail stamp;\ncorrelation cannot emit it).",
          "type": "string"
        }
      ]
    },
    "TargetRef": {
      "additionalProperties": false,
      "description": "One proposed delivery target.",
      "properties": {
        "adapter": {
          "description": "Operator-declared adapter identity (a bare name or an exact\npackage pin) — copied into the handoff exactly as declared.",
          "type": "string"
        },
        "id": {
          "description": "Reviewed logical target id.",
          "type": "string"
        },
        "locator": {
          "description": "Mutable origin locator (URL or path).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "locator",
        "adapter"
      ],
      "type": "object"
    },
    "Treatment": {
      "description": "Closed treatment set (RFC-104 D7).",
      "oneOf": [
        {
          "const": "preserve",
          "description": "Required behaviour or constraint that must survive.",
          "type": "string"
        },
        {
          "const": "change",
          "description": "Intentional divergence.",
          "type": "string"
        },
        {
          "const": "retire",
          "description": "Intentionally removed.",
          "type": "string"
        },
        {
          "const": "investigate",
          "description": "Insufficient evidence or authority for a responsible decision.",
          "type": "string"
        }
      ]
    },
    "Wave": {
      "additionalProperties": false,
      "description": "One bounded migration wave (RFC-104 D9).",
      "properties": {
        "acceptance": {
          "description": "The acceptance boundary.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "affected-elements": {
          "description": "Elements that may experience an observable consequence.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "architecture": {
          "$ref": "#/$defs/WaveArchitecture",
          "description": "Named `system.yaml` states before and after the wave."
        },
        "assumptions": {
          "description": "Commercial assumptions.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "coexistence": {
          "description": "Coexistence requirements.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "conservation": {
          "description": "Conservation expectations (RFC-98 consumes them later).",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "context-elements": {
          "description": "Read-only architectural context.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cutover": {
          "description": "Cutover requirements.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "decisions": {
          "description": "Authority decisions (refs to `decisions/<id>.yaml`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delivery-mappings": {
          "description": "Reviewed source-to-target assignments.",
          "items": {
            "$ref": "#/$defs/DeliveryMapping"
          },
          "type": "array"
        },
        "dispositions": {
          "description": "Disposition ids this wave enacts (refs into `dispositions[]`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence-scopes": {
          "description": "The selected estate-survey leads delivery will import.",
          "items": {
            "$ref": "#/$defs/EvidenceScope"
          },
          "type": "array"
        },
        "gaps": {
          "description": "Material unknowns.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable wave id, unique across the file.",
          "type": "string"
        },
        "operational-readiness": {
          "description": "Operational-readiness requirements.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "outcome": {
          "description": "The bounded outcome.",
          "type": "string"
        },
        "preconditions": {
          "description": "External preconditions.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "predecessors": {
          "description": "Predecessor wave ids within this plan.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rollback": {
          "description": "Rollback position.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "state-movements": {
          "description": "State movement and reconciliation.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "targets": {
          "description": "Proposed delivery targets, including targets that must be\ncreated before RFC-88 authoring.",
          "items": {
            "$ref": "#/$defs/TargetRef"
          },
          "type": "array"
        },
        "touched-elements": {
          "description": "Elements in the delivery ownership envelope.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "verification": {
          "description": "Verification expectations.",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "outcome",
        "architecture"
      ],
      "type": "object"
    },
    "WaveArchitecture": {
      "additionalProperties": false,
      "description": "The named states a wave moves between.",
      "properties": {
        "after": {
          "description": "Named `system.yaml` state after the wave.",
          "type": "string"
        },
        "before": {
          "description": "Named `system.yaml` state before the wave.",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/augentic/emery/answers/proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated judgment-answer schema — generated from the Rust wire types by system::answers; do not edit. Validates the schema-gated answer to the initial system-plan proposal judgment: the `kind: response` envelope carrying the proposed `target` state, optional `transition-*` states, modernization dispositions, and exactly one migration wave. The deterministic tail re-parses the answer, validates every proposed state, and closes claims, evidence scopes, and decision references against the live definition home.",
  "properties": {
    "dispositions": {
      "default": [],
      "description": "Proposed modernization dispositions.",
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/ResponseKind",
      "description": "Envelope kind."
    },
    "target": {
      "$ref": "#/$defs/State",
      "description": "The proposed `target` named state."
    },
    "transitions": {
      "additionalProperties": {
        "$ref": "#/$defs/State"
      },
      "default": {},
      "description": "Proposed intermediate states, keyed `transition-<kebab>`.\nEmpty for a one-hop migration.",
      "type": "object"
    },
    "version": {
      "description": "Schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "wave": {
      "$ref": "#/$defs/Wave",
      "description": "The proposed first migration wave."
    }
  },
  "required": [
    "version",
    "kind",
    "target",
    "wave"
  ],
  "title": "Emery system-plan proposal answer",
  "type": "object"
}
