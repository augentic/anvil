{
  "$defs": {
    "ClaimRef": {
      "additionalProperties": false,
      "description": "One claim reference into persisted Evidence.",
      "properties": {
        "id": {
          "description": "Claim id within that source's Evidence.",
          "type": "string"
        },
        "source": {
          "description": "Coverage-row source key.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "description": "One model element.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Open attribute map (D6 state and temporal facts live here).",
          "type": "object"
        },
        "claims": {
          "default": [],
          "description": "Claim refs into persisted Evidence.",
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "type": "array"
        },
        "context-only": {
          "default": false,
          "description": "Relevant to the migration without being modified by it.",
          "type": "boolean"
        },
        "decision": {
          "description": "The `decisions/<id>.yaml` record behind `status: decided`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable element id, unique across the state.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind",
          "description": "Closed element vocabulary."
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Epistemic status of this record."
        }
      },
      "required": [
        "id",
        "kind",
        "status"
      ],
      "type": "object"
    },
    "ElementKind": {
      "description": "Closed element vocabulary (RFC-104 D4).",
      "oneOf": [
        {
          "const": "system",
          "description": "A whole system within or beside the boundary.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "A service or component.",
          "type": "string"
        },
        {
          "const": "repository",
          "description": "A source repository.",
          "type": "string"
        },
        {
          "const": "interface",
          "description": "An exposed interface (API, UI, file feed).",
          "type": "string"
        },
        {
          "const": "data-store",
          "description": "A data store.",
          "type": "string"
        },
        {
          "const": "queue",
          "description": "A queue or topic.",
          "type": "string"
        },
        {
          "const": "scheduled-job",
          "description": "A scheduled job.",
          "type": "string"
        },
        {
          "const": "deployment-unit",
          "description": "A deployment unit.",
          "type": "string"
        },
        {
          "const": "environment",
          "description": "A runtime environment.",
          "type": "string"
        },
        {
          "const": "external-actor",
          "description": "An external actor or system.",
          "type": "string"
        },
        {
          "const": "owning-group",
          "description": "An owning group.",
          "type": "string"
        }
      ]
    },
    "Relationship": {
      "additionalProperties": false,
      "description": "One model relationship.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Open attribute map.",
          "type": "object"
        },
        "claims": {
          "default": [],
          "description": "Claim refs into persisted Evidence.",
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "type": "array"
        },
        "context-only": {
          "default": false,
          "description": "Relevant to the migration without being modified by it.",
          "type": "boolean"
        },
        "decision": {
          "description": "The `decisions/<id>.yaml` record behind `status: decided`.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "Source element id.",
          "type": "string"
        },
        "id": {
          "description": "Stable relationship id, unique across the state.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationshipKind",
          "description": "Closed relationship vocabulary."
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Epistemic status of this record."
        },
        "to": {
          "description": "Destination element id.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "status"
      ],
      "type": "object"
    },
    "RelationshipKind": {
      "description": "Closed relationship vocabulary (RFC-104 D4).",
      "oneOf": [
        {
          "const": "containment",
          "description": "`from` contains `to`.",
          "type": "string"
        },
        {
          "const": "deployment",
          "description": "`from` is deployed onto `to`.",
          "type": "string"
        },
        {
          "const": "invocation",
          "description": "`from` invokes `to`.",
          "type": "string"
        },
        {
          "const": "publication",
          "description": "`from` publishes to `to`.",
          "type": "string"
        },
        {
          "const": "consumption",
          "description": "`from` consumes from `to`.",
          "type": "string"
        },
        {
          "const": "read",
          "description": "`from` reads `to`.",
          "type": "string"
        },
        {
          "const": "write",
          "description": "`from` writes `to`.",
          "type": "string"
        },
        {
          "const": "dependency",
          "description": "`from` depends on `to`.",
          "type": "string"
        },
        {
          "const": "ownership",
          "description": "`from` owns `to`.",
          "type": "string"
        }
      ]
    },
    "ResponseKind": {
      "description": "Correlation response envelope kind.",
      "oneOf": [
        {
          "const": "response",
          "description": "The agent's correlation result.",
          "type": "string"
        }
      ]
    },
    "State": {
      "additionalProperties": false,
      "description": "One named architecture state.",
      "properties": {
        "elements": {
          "default": [],
          "description": "Stable elements, in model order.",
          "items": {
            "$ref": "#/$defs/Element"
          },
          "type": "array"
        },
        "relationships": {
          "default": [],
          "description": "Relationships between element ids.",
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Status": {
      "description": "Closed epistemic status set.",
      "oneOf": [
        {
          "const": "evidenced",
          "description": "Backed by at least one persisted claim.",
          "type": "string"
        },
        {
          "const": "inferred",
          "description": "Model inference with no claims; repetition never promotes it.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Disagreeing claims are retained, none wins.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "An explicit gap with no claims.",
          "type": "string"
        },
        {
          "const": "decided",
          "description": "Settled by a `decisions/<id>.yaml` record (persist-tail stamp;\ncorrelation cannot emit it).",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/augentic/emery/answers/correlation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated judgment-answer schema — generated from the Rust wire types by system::answers; do not edit. Validates the schema-gated answer to the system correlation judgment: the `kind: response` envelope carrying the composed `as-is` element and relationship set. The deterministic tail re-parses the answer, validates the state, and closes cited claims against the persisted Evidence corpus.",
  "properties": {
    "as-is": {
      "$ref": "#/$defs/State",
      "description": "The composed `as-is` element and relationship set."
    },
    "kind": {
      "$ref": "#/$defs/ResponseKind",
      "description": "Envelope kind."
    },
    "version": {
      "const": 1,
      "description": "Schema version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "kind",
    "as-is"
  ],
  "title": "Emery correlation answer",
  "type": "object"
}
