# Generated by Cargo

# Source/asset directories that share the `target` name with Cargo's build dir;
# without these exceptions .gitignore would silently exclude them from commits.
!/src/runtime/commands/target/
!/src/runtime/commands/target/**
!/schemas/target/
!/schemas/target/**

.env
target/
/specify

**/*.rs.bk
rustc-ice-*
.DS_Store
docs/book/

# Stable, browsable quality-profile sandbox
quality/.sandbox/

# Operator-invoked local runs (eval harness + change example)
sandbox/
sandbox.lock

# Specify project state and integration-run scratch logs
.specify/.cache/
.specify/project.yaml
stderr.log
stdout.log
