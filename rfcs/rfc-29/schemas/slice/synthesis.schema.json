{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augentic/specify-cli/schemas/slice/synthesis.schema.json",
  "title": "Specify slice synthesis",
  "description": "Validates the request/response envelope exchanged between the `specrun slice synthesize` engine and the agent-led synthesis step per RFC-29 \u00a7Slice synthesis engine (D3) and \u00a7Synthesis execution mode (D10). The request (`kind: request`) embeds each source's `extract` output inline under the Evidence map (the document's `lead` and `claims`, not a path), the kernel's pre-resolved authority inline as the `authority` array (one `{ source, kind, class }` row per contributing `(source, kind)`, effective class only \u2014 winner markers are kernel-projected after dispatch, never carried here), and the bound target's shape brief. Requirements reconciliation draws solely on Evidence and resolved authority; `target` and `shape-brief` are valid inputs for the non-requirements model sections only, and that wall is enforced by gate 1 and the `slice-synthesize-forbidden-input-leak` finding rather than a wire field. The response (`kind: response`) carries a draft `model` validated against `draft-model.schema.json` (claims, agreement, prose \u2014 no kernel-owned fields) plus prose-only Markdown artifacts (requirement bodies without `ID:` / `Sources:` / `Status:` lines). The engine validates the draft, rejects usurped kernel fields (`requirements[].id`, `.status`, `claims[].winner`) with `slice-synthesize-kernel-field-usurped`, projects the kernel, validates the merged `model.yaml` against `model.schema.json`, renders provenance lines into `spec.md`, then persists. Closed shapes \u2014 unknown fields are rejected.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@v\\d+$"
    },
    "claimKind": {
      "type": "string",
      "enum": [
        "intent",
        "requirement",
        "criterion",
        "decision",
        "section",
        "diagram",
        "contract",
        "example",
        "excerpt",
        "type",
        "call",
        "region",
        "container",
        "leaf"
      ]
    },
    "authorityClass": {
      "type": "string",
      "enum": [
        "intent",
        "documentation",
        "behaviour"
      ]
    },
    "resolvedAuthorityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "kind",
        "class"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/kebabName"
        },
        "kind": {
          "$ref": "#/$defs/claimKind"
        },
        "class": {
          "$ref": "#/$defs/authorityClass"
        }
      }
    },
    "claimPath": {
      "type": "string",
      "pattern": "^[^\\s][^\\s]*(#L[1-9][0-9]*(-L[1-9][0-9]*)?)?$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/claimKind"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
        },
        "path": {
          "$ref": "#/$defs/claimPath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "requirement" } },
            "required": ["kind"]
          },
          "then": { "required": ["id"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "criterion" } },
            "required": ["kind"]
          },
          "then": { "required": ["id"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "example" } },
            "required": ["kind"]
          },
          "then": { "required": ["id"] }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "slice",
        "target",
        "shape-brief",
        "evidence",
        "authority"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "kind": {
          "const": "request"
        },
        "slice": {
          "$ref": "#/$defs/kebabName"
        },
        "target": {
          "$ref": "#/$defs/targetRef"
        },
        "shape-brief": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/kebabName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/evidenceEntry"
          }
        },
        "authority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedAuthorityEntry"
          }
        }
      }
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead",
        "claims"
      ],
      "properties": {
        "lead": {
          "$ref": "#/$defs/kebabName"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "slice",
        "model",
        "artifacts"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "kind": {
          "const": "response"
        },
        "slice": {
          "$ref": "#/$defs/kebabName"
        },
        "model": {
          "$ref": "draft-model.schema.json"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "design",
        "tasks",
        "specs"
      ],
      "properties": {
        "proposal": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "string",
          "minLength": 1
        },
        "specs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "content"
            ],
            "properties": {
              "unit": {
                "$ref": "#/$defs/kebabName"
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
