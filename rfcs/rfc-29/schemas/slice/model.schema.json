{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augentic/specify-cli/schemas/slice/model.schema.json",
  "title": "Specify slice model.yaml",
  "description": "Validates a slice's typed machine-readable model per RFC-29 \u00a7Typed slice model. Generated by `specrun slice synthesize` after kernel projection and regenerated whole on re-synthesis. Operators edit behavioral prose in `spec.md` / `design.md` / `tasks.md`; `model.yaml` is the machine view target builders consume. One slice binds one target (RFC-29 D5 \u00a7Per-slice fan-out) \u2014 `target` is a scalar, not an array. Agent judgment inputs (`requirements[].claims`, draft-only `requirements[].agreement`, and prose) arrive via `draft-model.schema.json`; kernel-projected fields (`requirements[].id`, `.status`, and `claims[].winner`) are stamped during projection. Kernel-rendered provenance lines in `spec.md` must match projected ids/status/source lists or `slice-spec-provenance-stale` fires. `slice-model-provenance-drift` checks `model.yaml` vs `provenance.yaml` at `(source, claim-id)` granularity; `slice-model-target-drift` checks plan binding. Closed top-level shape \u2014 unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "slice",
    "target",
    "requirements",
    "domain",
    "apis",
    "configuration",
    "technical-logic",
    "observability",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "slice": {
      "$ref": "#/$defs/kebabName"
    },
    "target": {
      "$ref": "#/$defs/targetRef"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelRequirement"
      }
    },
    "domain": {
      "$ref": "#/$defs/modelDomain"
    },
    "apis": {
      "$ref": "#/$defs/modelApis"
    },
    "configuration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelConfiguration"
      }
    },
    "technical-logic": {
      "$ref": "#/$defs/modelTechnicalLogic"
    },
    "observability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelObservability"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelTask"
      }
    }
  },
  "$defs": {
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$",
      "description": "Dotted Evidence claim id (e.g. `password-reset.expiry`); mirrors the claim-id grammar in `evidence.schema.json`."
    },
    "claimKind": {
      "type": "string",
      "enum": [
        "intent",
        "requirement",
        "criterion",
        "decision",
        "section",
        "diagram",
        "contract",
        "example",
        "excerpt",
        "type",
        "call",
        "region",
        "container",
        "leaf"
      ],
      "description": "Closed claim-kind enum mirrored byte-identically from `evidence.schema.json#/$defs/claimKind`. Carried on each `model.yaml` claim (D13) so the kernel resolves per-kind authority (\u00a7Authority over mixed-kind claims) without re-reading Evidence."
    },
    "reqId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DEC-[0-9]{3}$"
    },
    "typeId": {
      "type": "string",
      "pattern": "^TYP-[0-9]{3}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^OP-[0-9]{3}$"
    },
    "configId": {
      "type": "string",
      "pattern": "^CFG-[0-9]{3}$"
    },
    "observabilityId": {
      "type": "string",
      "pattern": "^OBS-[0-9]{3}$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@v\\d+$",
      "description": "Mirrors `plan.schema.json` slice `target` pattern."
    },
    "requirementStatus": {
      "type": "string",
      "enum": [
        "agreed",
        "unknown",
        "conflict",
        "divergence"
      ]
    },
    "modelRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "statement",
        "claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reqId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/requirementStatus"
        },
        "unit": {
          "$ref": "#/$defs/kebabName"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelClaim"
          },
          "description": "Agent-authored claim-level provenance: every `(source, claim-id, kind)` claim that fed this requirement, winners and losers alike. Empty for an `unknown` requirement. `kind` (D13) lets the kernel resolve per-kind authority and project `provenance.yaml`; the `winner` marker on each entry is kernel-projected."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "modelClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "claim-id",
        "kind"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/kebabName"
        },
        "claim-id": {
          "$ref": "#/$defs/claimId"
        },
        "kind": {
          "$ref": "#/$defs/claimKind",
          "description": "Agent-authored: the kind of the cited Evidence claim (D13). The kernel uses it to apply per-kind authority (\u00a7Authority over mixed-kind claims) and to populate the `kind`-bearing `provenance.yaml` `contributing-claims[]` without re-reading Evidence. `slice-model-claim-kind-mismatch` rejects a value that disagrees with the kind recorded for that `(source, claim-id)` in Evidence."
        },
        "winner": {
          "type": "boolean",
          "description": "Kernel-projected. Present (`true` on the authority-resolved winner, `false` on every dropped loser) only for a `divergence` requirement; absent for `agreed` and `conflict` requirements, matching `provenance.yaml` winner semantics."
        }
      }
    },
    "modelDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types"
      ],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "fields"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/typeId"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "record",
                  "enum",
                  "alias",
                  "newtype"
                ],
                "default": "record"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "optional": {
                      "type": "boolean",
                      "default": false
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "modelApis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "operations"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebabName"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "rest",
                  "graphql",
                  "grpc",
                  "asyncapi",
                  "cli",
                  "library",
                  "ui"
                ]
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/operationId"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request": {
                      "type": "string"
                    },
                    "response": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "satisfies": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/reqId"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "modelConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/configId"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "modelTechnicalLogic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions"
      ],
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/decisionId"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string"
              },
              "satisfies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/reqId"
                }
              }
            }
          }
        }
      }
    },
    "modelObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/observabilityId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "metric",
            "trace",
            "log",
            "alert"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "modelTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "depends-on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "satisfies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reqId"
          }
        }
      }
    }
  }
}
