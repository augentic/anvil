#!/usr/bin/env bash
set -euo pipefail

# Bump the git tag or rev pin for specify-domain / specify-error in tooling/Cargo.toml.
#
# Usage:
#   scripts/bump-specify-cli v0.2.0
#   scripts/bump-specify-cli --rev c99b12679128eac822fe0f78dc708181fc7fb437

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="${ROOT}/tooling/Cargo.toml"
MODE="tag"
REF="${1:-}"

if [[ "${REF}" == "--rev" ]]; then
  MODE="rev"
  REF="${2:-}"
fi

if [[ -z "${REF}" ]]; then
  echo "usage: scripts/bump-specify-cli <tag>" >&2
  echo "       scripts/bump-specify-cli --rev <commit>" >&2
  echo "example: scripts/bump-specify-cli v0.2.0" >&2
  exit 2
fi

if [[ ! -f "${MANIFEST}" ]]; then
  echo "error: missing ${MANIFEST}" >&2
  exit 1
fi

python3 - "${MANIFEST}" "${MODE}" "${REF}" <<'PY'
import pathlib
import re
import sys

manifest = pathlib.Path(sys.argv[1])
mode = sys.argv[2]
ref = sys.argv[3]
text = manifest.read_text()
key = "tag" if mode == "tag" else "rev"
pattern = (
    r'(specify-(?:domain|error) = \{ git = "https://github.com/augentic/specify-cli.git", '
    r'(?:tag|rev) = ")[^"]+(" \})'
)
updated = re.sub(pattern, rf'\1{ref}\2', text)
updated = re.sub(
    r'(specify-(?:domain|error) = \{ git = "https://github.com/augentic/specify-cli.git", )(?:tag|rev) =',
    rf'\1{key} =',
    updated,
)
if updated == text:
    raise SystemExit("error: no specify-domain/specify-error git pins found to update")
manifest.write_text(updated)
print(f"updated {manifest} -> {key} = \"{ref}\"")
PY

echo "Run: cargo update --manifest-path tooling/Cargo.toml"
