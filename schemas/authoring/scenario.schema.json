{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augentic/specify/schemas/authoring/scenario.schema.json",
  "title": "Specify scenario",
  "description": "Validates canonical YAML scenario documents and the legacy Markdown frontmatter accepted during migration.",
  "oneOf": [
    {
      "$ref": "#/$defs/canonical"
    },
    {
      "$ref": "#/$defs/legacy-frontmatter"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 96
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "assertion-id": {
      "type": "string",
      "enum": [
        "plan-exists",
        "plan-validates",
        "execute-loop-all-done",
        "intent-single-lead",
        "gate-1-not-auto-stamped",
        "sources-intent-only",
        "refine-reaches-refined",
        "single-slice-from-doc",
        "sources-documentation-only",
        "multiple-slices-proposed",
        "cross-cutting-lead-multi-homed",
        "propose-edit-reject-loop",
        "gate-1-amendment",
        "multiple-slices-from-code",
        "sources-legacy-only",
        "no-under-slicing",
        "merged-slice-combines-sources",
        "tentative-merge-surfaced",
        "amend-overrides-merge",
        "extract-runs-per-contributing-source",
        "slices-match-expected-shape",
        "no-project-routing-required",
        "contract-slice-first",
        "implementation-slices-routed",
        "dependencies-contract-before-implementations",
        "draft-stops-at-handoff",
        "review-step-no-op",
        "workspace-branches-prepared",
        "publication-complete-before-finalize",
        "finalize-archives-plan",
        "archived-plan-path-recorded",
        "archived-change-md-present",
        "publication-confirmation-recorded",
        "rerun-finalize-plan-not-found",
        "spec-reflects-shape-idioms",
        "design-reflects-shape-idioms",
        "intent-and-doc-fixtures-agree",
        "breakout-state-consistent",
        "execute-resumes-without-flags",
        "build-failure-stop-hint",
        "build-resumes-from-failed-task",
        "loop-continues-to-merge",
        "per-slice-project-routing",
        "slots-materialised",
        "plan-lock-at-workspace",
        "breakout-routes-to-slot",
        "active-slice-resolved-across-boundary",
        "chdir-without-operator-intervention",
        "guest-loop-drained",
        "guest-journal-cadence",
        "guest-generated-crate-verifies",
        "guest-marker-released",
        "guest-spec-sensible",
        "dirty-slot-preserved",
        "slice-state-preserved",
        "resume-continues-from-in-progress",
        "composed-init-succeeds",
        "project-scaffold-written",
        "composed-plan-drained",
        "composed-artifacts-complete",
        "composed-baseline-merge-visible"
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "environment"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "workflow-step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "run"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "command",
            "prompt"
          ]
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "$ref": "#/$defs/slug"
        },
        "fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime",
        "model",
        "grading",
        "trials",
        "environment"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "runtime": {
          "enum": [
            "native",
            "wasm"
          ]
        },
        "model": {
          "enum": [
            "scripted",
            "replay",
            "live"
          ]
        },
        "grading": {
          "enum": [
            "hard",
            "semantic"
          ]
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "destination"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "$ref": "#/$defs/relative-path"
        },
        "destination": {
          "$ref": "#/$defs/relative-path"
        }
      }
    },
    "probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "registered"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "step",
            "equals"
          ],
          "properties": {
            "kind": {
              "const": "exit-code"
            },
            "step": {
              "$ref": "#/$defs/slug"
            },
            "equals": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "path-exists",
                "path-absent"
              ]
            },
            "path": {
              "$ref": "#/$defs/relative-path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "step",
            "stream",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stream-contains"
            },
            "step": {
              "$ref": "#/$defs/slug"
            },
            "stream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "step",
            "pointer",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "json-equals"
            },
            "step": {
              "$ref": "#/$defs/slug"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:|/.*)$"
            },
            "value": true
          }
        }
      ]
    },
    "hard-assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "after",
        "probe"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/assertion-id"
        },
        "after": {
          "$ref": "#/$defs/slug"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "semantic-rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "after",
        "criterion",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/assertion-id"
        },
        "after": {
          "$ref": "#/$defs/slug"
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative-path"
          }
        }
      }
    },
    "expected-output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative-path"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "owner",
        "gate-tier",
        "isolation",
        "setup",
        "workflow",
        "profiles",
        "fixtures",
        "hard-assertions",
        "semantic-rubrics",
        "expected-outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "owner": {
          "$ref": "#/$defs/slug"
        },
        "gate-tier": {
          "enum": [
            "release-blocker",
            "full"
          ]
        },
        "isolation": {
          "enum": [
            "fresh-project",
            "shared-baseline",
            "shared-slice"
          ]
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflow-step"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          }
        },
        "hard-assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hard-assertion"
          }
        },
        "semantic-rubrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic-rubric"
          }
        },
        "expected-outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected-output"
          }
        }
      }
    },
    "legacy-frontmatter": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "kind",
        "entrypoint",
        "stages",
        "isolation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "owner": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "adapter",
            "adapter-boundary",
            "suite",
            "skill"
          ]
        },
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^/[a-z]+:[a-z][a-z0-9-]*$"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "plan",
              "refine",
              "build",
              "merge",
              "drop"
            ]
          }
        },
        "isolation": {
          "enum": [
            "fresh-project",
            "shared-baseline",
            "shared-slice"
          ]
        },
        "authorship-mode": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected-artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative-expectations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "adapter",
                  "adapter-boundary"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "adapter"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "adapter-boundary"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "negative-expectations"
            ],
            "properties": {
              "negative-expectations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}