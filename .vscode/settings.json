{
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100
    },
    "json.schemas": [
        {
            "fileMatch": [".cursor-plugin/marketplace.json"],
            "url": "./.cursor/schemas/marketplace.schema.json"
        }
    ],
    "yaml.schemas": {
        "https://github.com/augentic/specify-cli/raw/main/schemas/source.schema.json": [
            "adapters/sources/*/adapter.yaml"
        ],
        "https://github.com/augentic/specify-cli/raw/main/schemas/target.schema.json": [
            "adapters/targets/*/adapter.yaml"
        ],
        "./.cursor/schemas/skill.schema.json": [],
        "./.cursor/schemas/scenario.schema.json": [],
        "./.cursor/schemas/rule.schema.json": []
    }
}
