# Plan after step 3(d) Assignment + step 3(d).1 Registry proposal:
#   - ingest-pipeline-refactor → legacy-monolith (description match)
#   - operator-dashboard-alerts → command-centre (baseline-spec affinity)
#   - alpha-gateway-extract → alpha-gateway (newly-added registry entry)
# All three rows written via `specify plan amend --project <name>`.
version: 1
name: platform-modernisation
sources:
  monolith: git@github.com:augentic/legacy-monolith.git
changes:
  - name: ingest-pipeline-refactor
    status: pending
    project: legacy-monolith
    sources: [monolith]
    description: |
      Refactor ingest pipeline to drain the queue under back-pressure.
      Focus on src/ingest/.
  - name: operator-dashboard-alerts
    status: pending
    project: command-centre
    sources: [monolith]
    depends-on: [ingest-pipeline-refactor]
    description: |
      Surface ingest back-pressure events on the operator dashboard.
      Delta-targets ingest-pipeline-refactor.
  - name: alpha-gateway-extract
    status: pending
    project: alpha-gateway
    sources: [monolith]
    description: |
      Carve the inbound HTTP edge layer out of the monolith into a
      standalone gateway service. Focus on src/edge/.
