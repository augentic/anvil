name: platform-v2

sources:
  monolith: /path/to/legacy-codebase

changes:
  - name: user-registration
    sources: [monolith]
    status: done

  - name: email-verification
    sources: [monolith]
    depends-on: [user-registration]
    status: blocked
    status-reason: "Notification channel scope not specified in description; cannot safely design verification-email template without it."

  - name: registration-duplicate-email-crash
    description: >
      Duplicate email submission returns 500 instead of 409. Discovered
      during earlier triage of the user-registration rollout.
    status: done
