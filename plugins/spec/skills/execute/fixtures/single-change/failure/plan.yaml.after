name: platform-v2

sources:
  orders: git@github.com:org/orders-service.git
  payments: git@github.com:org/payments-service.git

changes:
  - name: shopping-cart
    sources: [orders]
    status: done

  - name: checkout-api
    sources: [payments]
    depends-on: [shopping-cart]
    status: failed
    status-reason: "Type mismatch between cart line-item schema and payment gateway contract."
