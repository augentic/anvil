{
  "version": 1,
  "source-key": "legacy-widget",
  "language": "typescript",
  "surfaces": [
    {
      "id": "http-get-widgets",
      "kind": "http-route",
      "identifier": "GET /widgets",
      "handler": "src/handlers/list.ts:listWidgets",
      "touches": [
        "src/handlers/list.ts",
        "src/services/widget-service.ts"
      ],
      "declared-at": [
        "src/server.ts:10"
      ]
    },
    {
      "id": "http-get-widgets-id",
      "kind": "http-route",
      "identifier": "GET /widgets/:id",
      "handler": "src/handlers/get.ts:getWidget",
      "touches": [
        "src/handlers/get.ts",
        "src/services/widget-service.ts"
      ],
      "declared-at": [
        "src/server.ts:11"
      ]
    },
    {
      "id": "http-post-widgets",
      "kind": "http-route",
      "identifier": "POST /widgets",
      "handler": "src/handlers/create.ts:createWidget",
      "touches": [
        "src/handlers/create.ts",
        "src/services/validate.ts",
        "src/services/widget-service.ts"
      ],
      "declared-at": [
        "src/server.ts:12"
      ]
    }
  ]
}
