# .specify/slices/product-catalog/journal.yaml after self-heal
# appends its one type: recovery entry documenting the mid-change
# resume. /spec:define's journal entries (if any) sit above this
# one unchanged — self-heal only appends.

entries:
  - timestamp: 2026-04-19T14:47:08Z
    step: build
    type: recovery
    summary: "Self-heal on startup: resumed mid-change build phase (LifecycleStatus=defined)."
    context: |
      before=plan:in-progress / lifecycle:defined
      after=plan:in-progress / lifecycle:defined (resuming /spec:build)
      Diagnostic: .metadata.yaml had no `outcome` field and
      LifecycleStatus==defined — /spec:define advanced the lifecycle
      but crashed before stamping its phase outcome, or the driver
      crashed in the window between /spec:define returning and
      /spec:build starting. Per RFC-2 §"Plan Mutation and Crash
      Safety" this is an active change dir with no terminal outcome
      yet, so no plan transition is applied; driver jumped to step 7
      of the supervised run (invoke /spec:build product-catalog) with
      the plan entry already in `in-progress`.
