# .specify/slices/checkout-api/journal.yaml after self-heal appends
# its one type: recovery entry. The three type: failure entries above
# were authored by /spec:build on the prior (crashed) run — self-heal
# preserves them unchanged and appends the recovery entry at the end.

entries:
  - timestamp: 2026-04-19T11:15:02Z
    step: build
    type: failure
    summary: "Iteration 1/3: cargo test failed — type mismatch in line-item quantity field."
    context: |
      error[E0308]: mismatched types
        --> crates/checkout/src/gateway.rs:42:17
         |
      42 |     gateway.submit(line_item.quantity)?;
         |                    ^^^^^^^^^^^^^^^^^^ expected `i64`, found `u32`

  - timestamp: 2026-04-19T11:19:31Z
    step: build
    type: failure
    summary: "Iteration 2/3: widening to i64 broke cart serialization round-trip test."
    context: |
      test cart::line_item::tests::round_trip_json ... FAILED
      thread 'cart::line_item::tests::round_trip_json' panicked at
      'quantity: expected u32 but payload serialized as i64',
      crates/cart/src/line_item.rs:88:9

  - timestamp: 2026-04-19T11:23:12Z
    step: build
    type: failure
    summary: "Iteration 3/3: gateway contract patch rejected by schema compatibility check."
    context: |
      Changing the payment gateway OpenAPI contract from i64 to u32 would
      violate the server-side compatibility guarantees; this is a
      design-level mismatch, not one the build phase can repair on its own.
      Rolled up into the phase outcome as a single `failure` for the plan.

  - timestamp: 2026-04-19T11:41:05Z
    step: build
    type: recovery
    summary: "Self-heal on startup: applied terminal transition failed after finding failure outcome on build."
    context: |
      before=plan:in-progress / lifecycle:building
      after=plan:failed / lifecycle:dropped
      Diagnostic: .metadata.yaml had outcome{phase: build, outcome: failure}
      but plan.yaml still listed checkout-api as in-progress. Driver ran
      `/spec:drop checkout-api --reason "<outcome.summary>"` then
      `specify plan transition checkout-api failed --reason
      "<outcome.summary>"`, copying `outcome.summary` verbatim into
      `status-reason`.
