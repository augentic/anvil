# Byte-identical to inputs/registry.yaml — the `new-feature` shape never
# mutates the registry. Both projects existed at start; assignment routed
# the implementation slices to them without any `specify registry add`.
version: 1
projects:
  - name: omnia-backend
    url: git@github.com:org/omnia-backend.git
    capability: omnia@v1
    description: >
      Backend service for the storefront. Owns user accounts, settings
      persistence, and the theme-preference API the mobile app reads.
  - name: vectis-mobile
    url: git@github.com:org/vectis-mobile.git
    capability: vectis@v1
    description: >
      iOS and Android storefront shells. Owns settings screens,
      theme-aware UI components, and the cross-platform Crux core
      that calls the backend's theme-preference API.
