/// The `emery:adapter` contract (ADR-0008): one source axis, two
/// operations. Adapter guests export the `source` interface plus
/// `wasi:http/incoming-handler` (compiled-in references over MCP). No
/// resource types cross the seam: dispatch carries plain values,
/// routed by each call's `adapter-id` first argument.
package emery:adapter@0.1.0;

interface types {
  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }

  /// An exact routed adapter identity: "<axis>:<name>@<version>" for a
  /// pinned package identity (e.g. "source:documentation@1.0.0"),
  /// "<axis>:<name>" for an unpinned cache-backed component. Host-mediated
  /// dispatch routes each call to the exporting guest by this first
  /// argument; the wire type stays an opaque string.
  type adapter-id = string;
}

/// The source adapter contract: `extract` is the one judgment operation
/// (survey is gone — ADR-0008). The guest assembles a prompt from its
/// compiled-in fragments, issues `create` with an MCP grant naming its
/// own reference route and a workspace lend of the source view (or no
/// lend for an inline value), and deserializes the schema-gated answer.
///
/// Extract's return is the specification IR (A8/A16, ADR-0009 §3):
/// the engine fails closed when a claim kind's required extras are
/// absent, and every open extra crosses the seam verbatim.
interface source {
  use types.{ adapter-id, error };

  /// Read-only view for a location-backed source. No output-home grant
  /// and no writable stage.
  record workspace {
    /// Opaque identity of the preparation.
    id: string,
    /// Deployment-local path of the read-only view root.
    root: string,
  }

  /// Either a read-only source view or an inline value. Never an
  /// output-home path or lifecycle artifact root.
  variant content {
    workspace(workspace),
    value(string),
  }

  /// Typed source-operation input: the source binding key plus
  /// workspace-or-value. Sources are value-in — they never read the
  /// output home or lifecycle authority.
  record input {
    /// Source-binding key.
    key: string,
    /// Read-only source view or inline value.
    content: content,
  }

  /// Document-level authority class for an extracted claim set, per the
  /// closed authority hierarchy (`intent` > `documentation` >
  /// `behaviour`). Controls who wins a cross-source disagreement.
  enum authority {
    /// Operator directives. Highest authority.
    intent,
    /// Written specifications and documentation.
    documentation,
    /// Empirically observed behaviour. Lowest authority.
    behaviour
  }

  /// The closed claim-kind taxonomy shared with the wire type. New
  /// kinds require updating the contract and this record together.
  enum claim-kind {
    intent,
    requirement,
    criterion,
    decision,
    section,
    diagram,
    contract,
    /// Runtime capture claims emitted by the `captures` source adapter.
    example,
    excerpt,
    %type,
    call,
    region,
    container,
    leaf
  }

  /// The backing data of the claim's evidence.
  variant backing {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// The claim's kind from the closed taxonomy.
    kind: claim-kind,
    /// Stable claim identifier (dotted kebab slug, e.g.
    /// `password-reset.expiry`). Required when `kind` is `requirement`,
    /// `criterion`, or `example`; optional on other kinds.
    id: option<string>,
    /// Per-claim source anchor: `<path>`, `<path>#L<n>`, or
    /// `<path>#L<start>-L<end>`.
    path: option<string>,
    /// A synthesis-grade headline summarizing the semantic meaning of this
    /// claim. Used by synthesis to merge related claims across sources.
    /// An open per-kind body field on the wire, so answers may omit it.
    synopsis: option<string>,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    backing: option<backing>,
    /// Open per-kind body fields the closed record does not model
    /// (`statement`, `criterion`, `replay-digest`, …), carried as
    /// `(key, value)` pairs where each value is the field's canonical
    /// JSON encoding. Synthesis reads these verbatim (A8) — the seam
    /// must conserve them.
    extras: list<tuple<string, string>>,
  }

  /// The claim set returned by the extract operation.
  record evidence {
    /// The document-level authority class of this claim set.
    authority: authority,
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  /// The adapter's deterministic metadata: identity lives in the
  /// wasm-pkg package reference and axis in the exported world, so only
  /// the compatibility floor remains on the record.
  record adapter-metadata {
    /// Optional host-CLI compatibility floor: the exact minimum `emery`
    /// version this adapter needs. The host aborts at resolve time when
    /// the running binary is older. Absent means no floor.
    emery-floor: option<string>,
  }

  /// Read at resolve time and cached against the artifact digest.
  /// Metadata, not judgment: effect-free and answerable from
  /// compiled-in constants — no model call, no filesystem access.
  metadata: func(id: adapter-id) -> adapter-metadata;

  /// Thoroughly extract the source's claim set. An `async func` like
  /// every judgment operation — a sync-lifted export cannot block on
  /// the pending `completion.create` host future.
  extract: async func(id: adapter-id, input: input) -> result<evidence, error>;
}

/// A source adapter component: the one axis interface plus the MCP
/// references served over `wasi:http`.
world source-adapter {
  export source;
}
