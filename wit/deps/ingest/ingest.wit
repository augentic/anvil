/// The host-owned locator-ingest capability. Git clone and HTTPS fetch
/// cannot run in the engine guest; the host stages a tree (or file) and
/// snapshots it into the shared content-addressed store. Imported by
/// the workflow guest only.
package emery:ingest@0.1.0;

interface types {
  /// The error returned by ingest operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }

  /// One staged locator: exact pin, CID, and a deployment-local tree.
  record fetched {
    /// Exact locator (Git revisions are SHAs).
    locator: string,
    /// Tree identity `sha256:<64 hex>`.
    cid: string,
    /// Deployment-local path of the staged tree.
    root: string,
    /// Freshness warning (moved branch); ingest still used the recorded SHA.
    warning: option<string>,
  }
}

interface ingest {
  use types.{ error, fetched };

  /// Stage `locator`, snapshot it, and return the exact pin plus a
  /// local tree the guest can fingerprint. `recorded` is a previously
  /// interned CID; `prior` is a previously recorded Git SHA.
  fetch: async func(locator: string, recorded: option<string>, prior: option<string>) -> result<fetched, error>;
}

/// Host-side bindgen world for the ingest capability.
world ingest-host {
  import ingest;
}
