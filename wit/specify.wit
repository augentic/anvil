package augentic:specify@0.1.0;

interface types {
  use wasi:filesystem/types@0.2.0.{ descriptor };

  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }

  /// A node-independent, content-addressed reference. The guest cannot
  /// dereference it directly; reads/writes go through host imports.
  record artifact {
    /// Stable identity for caching, dedup, and replay across nodes, e.g. "sha256: …".
    digest: string,
  }

  /// A content-addressed snapshot identity (a git commit oid in the git
  /// backend). Portable: it names a build's starting point independently of
  /// which node the working tree was materialized on.
  record revision {
    /// The snapshot's stable identity (e.g. "sha256: …" or a git oid).
    digest: string,
  }

  /// One path-scoped edit, relative to a working tree's root. A present
  /// `content` is an add or a modify; an absent `content` is a delete.
  record edit {
    /// The edited file's path, relative to the working tree root.
    path: string,
    /// The new content as a content-addressed handle, or absent for a deletion.
    content: option<artifact>,
  }

  /// How a build changed a working tree, relative to `base`. This is the
  /// portable unit that crosses nodes to `merge` — never a shared mount.
  record change-set {
    /// The revision the edits apply against.
    base: revision,
    /// The per-path edits the build produced.
    edits: list<edit>,
  }

  /// A host-materialized, mutable project tree that an operation works
  /// *within*. It replaces the bare project path: the host materializes the
  /// tree from a base `revision` onto whichever node runs the operation, so the
  /// contract no longer assumes one globally shared disk. It exposes two
  /// deliberately different faces — a capability-scoped `descriptor` for guest
  /// (wasm) code, and an optional node-local `local-path` for a
  /// filesystem-capable `eval` backend (the agent), the one consumer that
  /// cannot hold a `descriptor` and must read and write through real OS paths.
  resource working-tree {
    /// The revision the tree was materialized from.
    base: func() -> revision;
    /// A capability-scoped directory handle for guest reads/writes via
    /// wasi:filesystem.
    root: func() -> descriptor;
    /// The node-local filesystem path of the materialized tree, for handing to
    /// a filesystem-capable `eval` backend (the agent). `none` means no real
    /// local tree exists on this node, so agent-driven operations are
    /// unavailable here.
    local-path: func() -> option<string>;
    /// Capture the in-place mutations as a portable delta against `base`.
    changes: func() -> result<change-set, error>;
  }
}

interface source {
  use types.{ error };
  use wasi:filesystem/types@0.2.0.{ descriptor };

  /// The lead returned by the survey operation.
  record lead {
    /// The path to the section in the source that the lead corresponds to.
    /// Uses the file#line syntax to identify the section.
    path: string,
    /// A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
  }

  /// The level of trust to place in this evidence during conflict resolution.
  enum trust-basis {
    /// Operator directives. Highest trust.
    directive,
    /// Written specifications. Medium trust.
    specification,
    /// Empirical observations. Lowest trust.
    observation
  }

  /// The backing data of the claim's evidence.
  variant claim-data {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// A synthesis-grade headline summarizing the semantic meaning of this evidence.
    /// Used by the synthesis engine to merge related claims across sources.
    synopsis: string,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    data: option<claim-data>,
  }

  /// The evidence returned by the extract operation.
  record evidence {
    /// The evidence's trust level.
    trust: trust-basis,
    // /// The lead that the evidence is bound to.
    // lead: string,
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  /// Decompose the source into leads. That is, *lightly* survey the source in order to create
  /// a map of its contents.
  survey: func() -> result<list<lead>, error>;

  /// Extract evidence from a source for a given lead. That is, *thoroughly* extract the evidence
  /// from the source for the given lead.
  extract: func(lead: lead) -> result<evidence, error>;
}

/// The target adapter contract.
interface target {
  use types.{ change-set, error, working-tree };

  /// Types of inputs used to build a slice.
  variant input {
    proposal(string),
    design(string),
    tasks(string),
    spec(string),
    other(string),
  }

  /// The severity of a finding.
  enum severity {
    critical,
    important,
    suggestion
  }

  /// A finding from the operation.
  record finding {
    /// The finding's rule identifier.
    rule-id: string,
    /// The severity of the finding.
    severity: severity,
    /// The detail of the finding.
    detail: string,
  }

  /// The status of the operation.
  enum status {
    success,
    failure,
  }

  /// Judgment returned by the `build` and `merge` operations. The resulting
  /// state — a build's delta, or the merged baseline — lives in the working
  /// tree, not in this report.
  record report {
    /// The status of the operation.
    status: status,
    /// The findings from the operation.
    findings: list<finding>,
  }

  /// Request to target adapter to get guidance on the expected build artifacts
  /// for the adapter. The returned guidance is prose describing the build
  /// artifacts expected for the slice.
  guidance: func() -> result<string, error>;

  /// Build a slice within a host-materialized working tree. The tree is lent
  /// (borrowed) for the call; the operation reads existing code through it and
  /// writes its changes in place. The report carries only judgment; the caller
  /// extracts the resulting delta from the tree via `working-tree.changes()`.
  build: func(slice: string, inputs: list<input>, tree: borrow<working-tree>) -> result<report, error>;

  /// Merge a built slice into the project's codebase. `delta` is the build's
  /// portable delta (theirs); `tree` is the baseline working tree (ours) it is
  /// folded into in place — a 3-way merge against `delta.base`. The agent
  /// resolves conflicts through the tree's `local-path` and validators re-run
  /// through its `descriptor`; the report carries the merge judgment. The
  /// merged baseline is the tree's new state, committed by the caller.
  merge: func(slice: string, delta: change-set, tree: borrow<working-tree>) -> result<report, error>;

}

world source-adapter {
  export source;
}

world target-adapter {
  export target;
}

world workflow {
  import target;
  import source;
}

