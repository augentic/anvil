/// The `augentic:specify` adapter contract, revised per RFC-61.
///
/// Adapter guests export exactly one axis interface (`source` xor `target`)
/// plus `wasi:http/incoming-handler`, which serves the adapter's compiled-in
/// reference shelf over MCP; there is no typed `references` interface — the
/// spawned agent fetches documents lazily through the HTTP export. Judgment
/// is an Omnia host effect, not part of this package: each judgment operation
/// issues `omnia:model/completion.create` from inside the adapter guest, with
/// `format: schema(...)` so the host gate validates the answer before the
/// guest deserializes it into the records below.
///
/// No resource types cross the guest-to-guest seam: Omnia's host-mediated
/// dispatch carries plain values only, routed by each call's `adapter-id`
/// first argument. Every guest in a deployment shares the same `[[mount]]`
/// preopens, so operations name trees by `revision` (plus an optional
/// subpath) and open their own `"."` preopen rather than receiving a
/// directory handle.
package augentic:specify@0.1.0;

interface types {
  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }

  /// A plan-bound adapter identity, e.g. "source:typescript" or "target:omnia".
  /// Host-mediated dispatch routes each call to the exporting guest by this
  /// first argument.
  type adapter-id = string;

  /// A node-independent, content-addressed reference, e.g. "sha256: …".
  /// Stable identity for caching, dedup, and replay. Forward hook for
  /// distributed working trees (RFC-55, deferred): with today's shared
  /// mounts, content is reachable directly through the `"."` preopen.
  type artifact = string;

  /// A content-addressed snapshot identity (a git commit oid in the git
  /// backend). Portable: it names a build's starting point independently of
  /// which node the working tree lives on. With today's shared mounts it
  /// names the state of the one live project tree; it is the forward hook
  /// for distributed working trees (RFC-55, deferred).
  type revision = string;

  /// One path-scoped edit, relative to a working tree's root. A present
  /// `content` is an add or a modify; an absent `content` is a delete.
  record edit {
    /// The edited file's path, relative to the working tree root.
    path: string,
    /// The new content as a content-addressed handle, or absent for a deletion.
    content: option<artifact>,
  }

  /// How a build changed a working tree, relative to `base`. With today's
  /// shared mounts the edits also land in place in the live tree; the
  /// changeset is the portable record of them, and the forward hook for
  /// crossing nodes (RFC-55, deferred).
  record changeset {
    /// The revision the edits apply against.
    base: revision,
    /// The per-path edits the build produced.
    edits: list<edit>,
  }
}

/// The source adapter contract. Both operations are judgment legs: the guest
/// assembles a prompt from its compiled-in brief, issues `create` with an MCP
/// grant naming its own reference route and a workspace lend of its `"."`
/// preopen, and deserializes the schema-gated answer into the records below.
interface source {
  use types.{ adapter-id, error };

  /// The lead returned by the survey operation.
  record lead {
    /// The path to the section in the source that the lead corresponds to.
    /// Uses the file#line syntax to identify the section.
    path: string,
    /// A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
  }

  /// The weight to assign this evidence during conflict resolution.
  enum weight {
    /// Operator directives. Highest weight.
    directive,
    /// Written specifications. Medium weight.
    specification,
    /// Empirical observations. Lowest weight.
    observation
  }

  /// The backing data of the claim's evidence.
  variant backing {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// A synthesis-grade headline summarizing the semantic meaning of this evidence.
    /// Used by the synthesis engine to merge related claims across sources.
    synopsis: string,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    backing: option<backing>,
  }

  /// The evidence returned by the extract operation.
  record evidence {
    /// The evidence's weight.
    weight: weight,
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  /// Lightly survey the source to create a map of its contents (decompose into leads).
  survey: func(id: adapter-id) -> result<list<lead>, error>;

  /// Thoroughly extract evidence from a source for a given lead.
  extract: func(id: adapter-id, lead: lead) -> result<evidence, error>;
}

/// The target adapter contract. `build` and `merge` are judgment legs
/// bracketed by deterministic guest code: prompt assembly and the `create`
/// call in the middle, validate-before-visible checks compiled in after the
/// answer lands.
interface target {
  use types.{ adapter-id, changeset, error, revision };

  /// Types of inputs used to build a slice.
  variant input {
    proposal(string),
    design(string),
    tasks(string),
    spec(string),
    other(string),
  }

  /// Names the tree a build or merge operates on. Every guest in the
  /// deployment shares the same `[[mount]]` preopens, so no directory handle
  /// crosses this boundary: the adapter opens its own `"."` preopen and
  /// resolves `subpath` beneath it. `base` names the snapshot the operation
  /// applies against.
  record working-tree {
    /// The snapshot the operation applies against.
    base: revision,
    /// Optional path beneath the shared mount root scoping the operation.
    subpath: option<string>,
  }

  /// The severity of a finding.
  enum severity {
    critical,
    important,
    suggestion
  }

  /// A finding from the operation.
  record finding {
    /// The finding's rule identifier.
    rule-id: string,
    /// The severity of the finding.
    severity: severity,
    /// The detail of the finding.
    detail: string,
  }

  /// The outcome of the operation.
  enum outcome {
    success,
    failure,
  }

  /// Judgment returned by the `build` and `merge` operations. The resulting
  /// state — a build's delta, or the merged baseline — lives in the working
  /// tree, not in this report.
  record report {
    /// The outcome of the operation.
    outcome: outcome,
    /// The findings from the operation.
    findings: list<finding>,
  }

  /// Guidance on the expected build artifacts for this target, read by core
  /// synthesis while authoring slice artifacts. (Earlier adapter vocabulary
  /// called this operation `shape`; `guidance` is canonical.)
  guidance: func(id: adapter-id) -> result<string, error>;

  /// Build a slice against the shared project mount. The adapter opens its
  /// own `"."` preopen, reads existing code through it, and writes its
  /// changes in place; the judgment leg runs behind the adapter's own
  /// `create` call, with references served from its MCP export. The report
  /// carries only judgment — the resulting delta lives in the tree, and the
  /// caller extracts it as a `changeset` against `base` where one is needed.
  build: func(id: adapter-id, slice: string, inputs: list<input>, tree: working-tree) -> result<report, error>;

  /// Merge a built slice into the project's baseline. `delta` is the build's
  /// portable delta (theirs) against `delta.base`; the baseline (ours) is
  /// reached through the shared mount named by `tree` and folded into in
  /// place — a 3-way merge. Conflict resolution is a judgment leg behind
  /// `create`; validators re-run in guest code after the answer lands. The
  /// report carries the merge judgment; the caller commits the merged
  /// baseline.
  merge: func(id: adapter-id, slice: string, delta: changeset, tree: working-tree) -> result<report, error>;
}

/// A source adapter component: one axis interface plus the MCP reference
/// shelf served over `wasi:http`.
world source-adapter {
  export source;
  export wasi:http/incoming-handler@0.2.0;
}

/// A target adapter component: one axis interface plus the MCP reference
/// shelf served over `wasi:http`.
world target-adapter {
  export target;
  export wasi:http/incoming-handler@0.2.0;
}

/// The workflow guest: the deployment's only `wasi:cli/run` exporter. Its
/// `source` / `target` imports are satisfied by Omnia's host-mediated
/// dispatch, routed to the exporting adapter guest by each call's
/// `adapter-id` first argument.
world workflow {
  import source;
  import target;
}
