/// The `specify:adapter` contract. Adapter guests export exactly one axis
/// interface (`source` xor `target`; the additive `adapter` world serves
/// both, e.g. the Specify-owned fixture) plus `wasi:http/incoming-handler`,
/// which serves the adapter's compiled-in references over MCP. Judgment is
/// an Omnia host effect: each judgment operation issues
/// `omnia:model/completion.create` with `format: schema(...)` so the host
/// gate validates the answer. The records below are the contract's source
/// of truth; the answer schemas the model host consumes are generated from
/// the matching Rust wire types (`project::answers` in `augentic/specify`)
/// minus call-scoped envelope fields the caller already knows. No resource
/// types cross the seam: host-mediated dispatch carries plain values only,
/// routed by each call's `adapter-id` first argument, and every guest opens
/// its own `"."` preopen rather than receiving a directory handle.
package specify:adapter@0.1.0;

interface types {
  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string),
  }

  /// A plan-bound adapter identity, e.g. "source:typescript" or "target:omnia".
  /// Host-mediated dispatch routes each call to the exporting guest by this
  /// first argument.
  type adapter-id = string;

  /// A content-addressed snapshot identity (a git commit oid in the git
  /// backend). Portable: it names a build's starting point independently of
  /// which node the working tree lives on. With today's shared mounts it
  /// names the state of the one live project tree; it is the forward hook
  /// for distributed working trees (deferred).
  type revision = string;
}

/// The source adapter contract. Both operations are judgment legs: the guest
/// assembles a prompt from its compiled-in prompt fragments, issues `create` with an MCP
/// grant naming its own reference route and a workspace lend of its `"."`
/// preopen, and deserializes the schema-gated answer into the records below.
interface source {
  use types.{ adapter-id, error };

  /// The lead returned by the survey operation: the discovery lead
  /// minus the envelope `source` key — the workflow guest attributes
  /// every lead a survey produces to the surveyed source itself.
  record lead {
    /// Stable kebab-case lead identifier, unique only within its source;
    /// identity is the `(source, lead)` pair. Named `lead` to match the
    /// wire key, so answers deserialize without a rename.
    lead: string,
    /// A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
    /// Agent-authored per-lead topic slugs (kebab-case). Empty means
    /// unclassified (an answer may omit the key); never blocks
    /// reconciliation.
    topics: list<string>,
  }

  /// Document-level authority class for an Evidence document, per the
  /// workflow's closed authority hierarchy (`intent` > `documentation` >
  /// `behaviour`). Controls who wins a cross-source disagreement.
  enum authority {
    /// Operator directives. Highest authority.
    intent,
    /// Written specifications and documentation.
    documentation,
    /// Empirically observed behaviour. Lowest authority.
    behaviour
  }

  /// The closed claim-kind taxonomy shared with the Evidence wire type.
  /// New kinds require updating the workflow contract and this record
  /// together.
  enum claim-kind {
    intent,
    requirement,
    criterion,
    decision,
    section,
    diagram,
    contract,
    /// Runtime capture claims emitted by the `captures` source adapter.
    example,
    excerpt,
    %type,
    call,
    region,
    container,
    leaf
  }

  /// The backing data of the claim's evidence.
  variant backing {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// The claim's kind from the closed taxonomy.
    kind: claim-kind,
    /// Stable claim identifier (dotted kebab slug, e.g.
    /// `password-reset.expiry`). Required when `kind` is `requirement`,
    /// `criterion`, or `example`; optional on other kinds.
    id: option<string>,
    /// Per-claim source anchor: `<path>`, `<path>#L<n>`, or
    /// `<path>#L<start>-L<end>`.
    path: option<string>,
    /// A synthesis-grade headline summarizing the semantic meaning of this evidence.
    /// Used by the synthesis engine to merge related claims across sources.
    /// An open per-kind body field on the wire, so answers may omit it.
    synopsis: option<string>,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    backing: option<backing>,
  }

  /// The evidence returned by the extract operation: the Evidence
  /// document minus the envelope `lead` key — the extract call names
  /// the lead, so the answer never repeats it.
  record evidence {
    /// The document-level authority class of this evidence.
    authority: authority,
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  /// The adapter's deterministic metadata — the facts
  /// the host consumes before dispatching an operation. Identity lives
  /// in the wasm-pkg package reference and axis in the exported world,
  /// so only the compatibility floor remains on the record.
  record adapter-metadata {
    /// Optional host-CLI compatibility floor: the exact minimum
    /// `specify` platform version this adapter needs. The host compares
    /// it against the running binary at resolve time and aborts when
    /// the binary is older. Absent means no floor.
    specify-floor: option<string>,
  }

  /// Deterministic adapter metadata, read by the host at resolve time
  /// and cached against the artifact digest. Metadata, not judgment:
  /// effect-free and answerable from compiled-in constants — no model
  /// call, no filesystem access.
  metadata: func(id: adapter-id) -> adapter-metadata;

  /// Lightly survey the source to create a map of its contents (decompose
  /// into leads). An `async func` like every judgment operation: the guest
  /// awaits the async `omnia:model/completion.create` import mid-call, and
  /// a sync-lifted export cannot block on a pending host future.
  survey: async func(id: adapter-id) -> result<list<lead>, error>;

  /// Thoroughly extract evidence from a source for a given lead.
  extract: async func(id: adapter-id, lead: lead) -> result<evidence, error>;
}

/// The target adapter contract. `build` and `merge` are judgment legs
/// bracketed by deterministic guest code: prompt assembly and the `create`
/// call in the middle, validate-before-visible checks compiled in after the
/// answer lands.
interface target {
  use types.{ adapter-id, error, revision };

  /// Types of inputs used to build a slice.
  variant input {
    proposal(string),
    design(string),
    tasks(string),
    spec(string),
    other(string),
  }

  /// Names the tree a build or merge operates on. Every guest in the
  /// deployment shares the same `[[mount]]` preopens, so no directory handle
  /// crosses this boundary: the adapter opens its own `"."` preopen and
  /// resolves `subpath` beneath it. `base` names the snapshot the operation
  /// applies against.
  record working-tree {
    /// The snapshot the operation applies against.
    base: revision,
    /// Optional path beneath the shared mount root scoping the operation.
    subpath: option<string>,
  }

  /// The severity of a finding. The closed review severity enum shared
  /// with the `Diagnostic` wire type, ordered for sort stability
  /// (`critical` < `important` < `suggestion` < `optional`).
  enum severity {
    critical,
    important,
    suggestion,
    optional
  }

  /// A finding from the operation: the compact projection of one
  /// diagnostic from the schema-gated answer (whose `findings[]` carry
  /// the full `Diagnostic` wire shape). The
  /// guest maps `rule-id` and `severity` through and folds the
  /// diagnostic's `title` / `impact` / `remediation` prose into
  /// `detail`; the full diagnostic stays in the answer, not on the seam.
  record finding {
    /// The finding's rule identifier. Optional in the diagnostic shape —
    /// absent for findings that do not cite codex policy.
    rule-id: option<string>,
    /// The severity of the finding.
    severity: severity,
    /// The detail of the finding.
    detail: string,
  }

  /// The status of the operation.
  enum status {
    success,
    failure,
  }

  /// The closed target platform taxonomy shared with the build-report
  /// wire type.
  enum platform {
    core,
    ios,
    android,
    web,
    desktop
  }

  /// One per-platform build output: a relative path (from the project
  /// root) to a produced artifact. The caller verifies each declared
  /// path exists and is non-empty.
  record build-output {
    /// Platform this output was produced for.
    platform: platform,
    /// Relative path (from the project root) to the produced artifact.
    path: string,
  }

  /// Per-slice UI-surface signal authored from the build's own screen
  /// identification judgement. `screens: 0` means no UI surface.
  record ui-surface {
    /// Count of screen-bearing requirements this slice introduces or modifies.
    screens: u32,
  }

  /// Which side of the deterministic core merge a `merge` dispatch runs
  /// on. The engine folds the slice's deltas, promotes Decision Records,
  /// and archives the slice deterministically in Rust; the target's
  /// judgment brackets that commit.
  enum merge-phase {
    /// Before the deterministic commit: staged composition / contract /
    /// build checks over the built slice. A blocking finding aborts the
    /// merge with the slice still `built`.
    preflight,
    /// After the deterministic commit: merged-baseline validators over
    /// the updated tree. The slice is already merged and archived, so a
    /// blocking finding is a terminal diagnostic, never a rollback.
    postflight,
  }

  /// Judgment returned by the `build` and `merge` operations: the
  /// build report minus the envelope keys (`version`, `slice`,
  /// `target`) the caller already knows. The
  /// resulting state — a build's delta, or the merged baseline — lives
  /// in the working tree, not in this report.
  record report {
    /// The status of the operation. Named `status` to match the wire
    /// key, so answers deserialize without a rename.
    status: status,
    /// The findings from the operation. On success, only non-blocking
    /// findings (or none); partial success is `success` with
    /// non-blocking findings.
    findings: list<finding>,
    /// Per-platform build outputs produced by the operation. Empty when
    /// the answer omits the key.
    outputs: list<build-output>,
    /// Optional per-slice UI-surface signal; absent reports stay valid.
    ui-surface: option<ui-surface>,
  }

  /// One adapter-declared build input: a path (relative to the slice
  /// tree) the `build` operation consumes, flagged `required`.
  record build-input {
    /// Slice-tree-relative path of the input.
    path: string,
    /// Whether the build must abort when the path is absent.
    required: bool,
  }

  /// Declarative platforms capability: when `required` is true,
  /// projects using this target must declare a non-empty platform set
  /// at init.
  record platforms-capability {
    /// Whether projects must declare a platform set.
    required: bool,
    /// The set of platforms this target accepts.
    allowed: list<platform>,
    /// The set assumed when the operator accepts the default.
    default: list<platform>,
  }

  /// The adapter's deterministic metadata — the facts
  /// the host consumes before dispatching an operation. Identity lives
  /// in the wasm-pkg package reference and axis in the exported world;
  /// the record carries the compatibility floor plus the target's
  /// declared build inputs and platform capability.
  record adapter-metadata {
    /// Optional host-CLI compatibility floor: the exact minimum
    /// `specify` platform version this adapter needs. The host compares
    /// it against the running binary at resolve time and aborts when
    /// the binary is older. Absent means no floor.
    specify-floor: option<string>,
    /// Adapter-declared build inputs, each a slice-tree-relative path
    /// the `build` operation consumes. Empty when the target declares
    /// none.
    inputs: list<build-input>,
    /// Declarative platforms capability. Absent when the target is
    /// platform-agnostic.
    platforms: option<platforms-capability>,
  }

  /// Deterministic adapter metadata, read by the host at resolve time
  /// and cached against the artifact digest. Metadata, not judgment:
  /// effect-free and answerable from compiled-in constants — no model
  /// call, no filesystem access.
  metadata: func(id: adapter-id) -> adapter-metadata;

  /// Guidance on the expected build artifacts for this target, read by core
  /// synthesis while authoring slice artifacts. (Earlier adapter vocabulary
  /// called this operation `shape`; `guidance` is canonical.) Deterministic
  /// today, but an `async func` like the rest of the interface so an
  /// adapter may consult its model without a contract change.
  guidance: async func(id: adapter-id) -> result<string, error>;

  /// Build a slice against the shared project mount. The adapter opens its
  /// own `"."` preopen, reads existing code through it, and writes its
  /// changes in place; the judgment leg runs behind the adapter's own
  /// `create` call, with references served from its MCP export. The report
  /// carries only judgment — the resulting delta lives in the tree.
  build: async func(id: adapter-id, slice: string, inputs: list<input>, tree: working-tree) -> result<report, error>;

  /// Run one target-specific merge gate around the engine's deterministic
  /// core merge. Dispatched twice per slice merge: `preflight` before the
  /// engine folds the slice's deltas into the baseline, `postflight` after
  /// the commit and archive. The adapter reads both the built slice and the
  /// baseline through the shared mount named by `tree`; the report carries
  /// only judgment — lifecycle transitions, baseline spec merging, and
  /// archive moves stay engine-owned.
  merge: async func(id: adapter-id, slice: string, phase: merge-phase, tree: working-tree) -> result<report, error>;
}

/// A source adapter component: one axis interface plus the MCP reference
/// references served over `wasi:http`.
world source-adapter {
  export source;
}

/// A target adapter component: one axis interface plus the MCP reference
/// references served over `wasi:http`.
world target-adapter {
  export target;
}

/// A combined source and target adapter component. Additive: external
/// adapters remain single-axis (`source-adapter` xor `target-adapter`);
/// this world exists for components that deliberately serve both axes,
/// such as the Specify-owned harness adapter, bound under one artifact
/// at both a `source:<name>` and a `target:<name>` dispatch id.
world adapter {
  export source;
  export target;
}

/// The workflow guest: the deployment's only `wasi:cli/run` exporter. Its
/// `source` / `target` imports are satisfied by Omnia's host-mediated
/// dispatch, routed to the exporting adapter guest by each call's
/// `adapter-id` first argument.
world workflow {
  import source;
  import target;
}
