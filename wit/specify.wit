package augentic:specify@0.1.0;

interface types {
  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string)
  }

  // ------------------------------------------------------
  // Source survey
  // ------------------------------------------------------

  /// Request to survey a source.
  record survey-request {
    /// The source being surveyed.
    source: string,
  }

  /// The lead returned by the survey operation.
  record lead {
    /// The lead's unique identifier.
    id: string,
    /// The source that surfaced the lead.
    source: string,
    /// A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
    /// Optional agent-authored per-lead topic slugs (kebab-case).
    topics: list<string>,
  }

  // ------------------------------------------------------
  // Source extract
  // ------------------------------------------------------

  /// Request to extract evidence from a source.
  record extract-request {
    /// The slice being extracted (path identity for the Evidence).
    slice-name: string,
    /// The source that surfaced the leads.
    source: string,
    /// The leads bound to this slice.
    leads: list<string>,
  }

  /// The level of trust to place in this evidence during conflict resolution.
  enum trust-level {
    /// Operator directives. Highest trust.
    directive,
    /// Written specifications. Medium trust.
    specification,
    /// Empirical observations. Lowest trust.
    observation
  }

  /// The backing data of the claim's evidence.
  variant claim-data {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a large block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// A synthesis-grade headline summarizing the semantic meaning of this evidence.
    /// Used by the synthesis engine to merge related claims across sources.
    synopsis: string,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    data: option<claim-data>,
  }

  /// The evidence returned by the extract operation.
  record evidence {
    /// The evidence's trust level.
    trust-level: trust-level,
    /// The lead that the evidence is bound to.
    lead: string,
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  // ------------------------------------------------------
  // Target shape
  // ------------------------------------------------------

  /// Request to shape a slice.
  record shape-request {
    /// The slice being shaped.
    slice-name: string,
  }

  /// The severity of a finding.
  enum severity {
    critical,
    important,
    suggestion,
    optional
  }

  /// A finding from the operation.
  record finding {
    /// The finding's rule identifier.
    rule-id: string,
    /// The severity of the finding.
    severity: severity,
    /// The detail of the finding.
    detail: string,
  }

  /// The status of the operation.
  enum build-status {
    success,
    failure,
  }

  /// An output generated by the build.
  record build-output {
    /// The platform being built.
    platform: string,
    /// The path to the built output.
    path: string,
  }

  /// The report returned by the build operation.
  record build-report {
    /// The slice being built.
    slice-name: string,
    /// The status of the operation.
    status: build-status,
    /// The findings from the operation.
    findings: list<finding>,
    /// The outputs from the operation.
    outputs: list<build-output>,
  }

  /// The report returned by the shape operation.
  type shape-report = build-report;

  // ------------------------------------------------------
  // Target build
  // ------------------------------------------------------

  /// A named input to a build operation.
  record build-input {
    /// The input key.
    key: string,
    /// The input value.
    value: string,
  }

  /// Request to build a slice.
  record build-request {
    /// The slice being built.
    slice-name: string,
    /// The inputs to the build.
    inputs: list<build-input>,
  }

  // ------------------------------------------------------
  // Target merge
  // ------------------------------------------------------

  /// Request to merge a built slice into the project's codebase.
  record merge-request {
    /// The slice being merged.
    slice-name: string,
  }

  /// The report returned by the merge operation.
  type merge-report = build-report;
}

// ------------------------------------------------------
// Target and Source interfaces — the typed operation signatures a
// `tool` component exports. Capability params (project / slice handles)
// are deferred to RFC-52, which promotes them from a raw grant into
// named host-data effects; until then `tool` operations reach host data
// through the existing preopen / $CAPABILITY_DIR grant.
// ------------------------------------------------------

interface target {
  use types.{
    shape-request, shape-report,
    build-request, build-report,
    merge-request, merge-report,
    error
  };

  shape: func(req: shape-request) -> result<shape-report, error>;
  build: func(req: build-request) -> result<build-report, error>;
  merge: func(req: merge-request) -> result<merge-report, error>;
}

interface source {
  use types.{ survey-request, lead, extract-request, evidence, error };

  survey: func(req: survey-request) -> result<list<lead>, error>;
  extract: func(req: extract-request) -> result<evidence, error>;
}


/// The project configuration access.
interface host-config {
  use types.{error};

  /// The project configuration.
  record configuration {
    project-name: string,
    target-ref: string,
    platforms: list<string>,
    workspace: bool,
  }

  /// Get the configuration.
  open: async func() -> result<configuration, error>;
}

interface host-data {
  use types.{error};

  /// Read slice data.
  read: func(id: string) -> result<list<u8>, error>;
}

world source-adapter {
  import host-config;
  import host-data;
}

world target-adapter {
  import host-config;
  import host-data;
  export target;
}

world workflow {
  import target;
  import source;

  export host-config;
  export host-data;

  // Note: the specific execution interface (e.g. `execute`)
  // can be defined and exported here as needed by the workflow design.
}

