package augentic:specify@0.1.0;

interface types {
  /// The error returned by operations.
  variant error {
    invalid-request(string),
    io(string),
    internal(string)
  }

  /// The project configuration.
  record configuration {
    project-name: string,
    target-ref: string,
    platforms: list<string>,
    workspace: bool,
  }

  /// The level of trust to place in this evidence during conflict resolution.
  enum trust-level {
    /// Operator directives. Highest trust.
    directive,
    /// Written specifications. Medium trust.
    specification,
    /// Empirical observations. Lowest trust.
    observation
  }

  /// The backing data of the claim's evidence.
  variant claim-data {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a large block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source adapter.
  record claim {
    /// A synthesis-grade headline summarizing the semantic meaning of this evidence.
    /// Used by the synthesis engine to merge related claims across sources.
    synopsis: string,
    /// The backing data of the claim's evidence (either a path or a raw payload).
    data: option<claim-data>,
  }

  /// The evidence returned by the extract operation.
  record evidence {
    /// The evidence's trust level.
    trust-level: trust-level,
    /// The lead that the evidence is bound to.
    lead: string,
    /// The claims extracted from the source.
    claims: list<claim>,
  }
}

interface source {
  use types.{ evidence, error };

  /// The lead returned by the survey operation.
  record lead {
    /// The path to the section in the source that the lead corresponds to.
    /// Uses the file#line syntax to identify the section.
    path: string,
    /// A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
  }

  /// Decompose the source into leads. That is, *lightly* survey the source in order to create
  /// a map of its contents.
  survey: func() -> result<list<lead>, error>;

  /// Extract evidence from a source for a given lead. That is, *thoroughly* extract the evidence
  /// from the source for the given lead.
  extract: func(lead: lead) -> result<evidence, error>;
}

/// The target adapter contract.
interface target {
  use types.{ error };

  // /// A named input to a build operation.
  // record key-value {
  //   /// The input key.
  //   key: string,
  //   /// The input value.
  //   value: string,
  // }

  /// Request to build a slice.
  record build-request {
    /// The slice being built.
    slice: string,
    /// The project directory for the slice.
    project-dir: string,
    /// The proposal document for the slice.
    proposal: string,
    /// The design document for the slice.
    design: string,
    /// The tasks document for the slice.
    tasks: string,
    /// The specs for the slice.
    specs: list<string>,
    /// The additional shape-specific inputs for the slice.
    additional: list<tuple<string, string>>,
  }

  /// The severity of a finding.
  enum severity {
    critical,
    important,
    suggestion,
    optional
  }

  /// A finding from the operation.
  record finding {
    /// The finding's rule identifier.
    rule-id: string,
    /// The severity of the finding.
    severity: severity,
    /// The detail of the finding.
    detail: string,
  }

  /// The status of the operation.
  enum status {
    success,
    failure,
  }

  // /// An output generated by the build.
  // record build-output {
  //   /// The platform being built.
  //   platform: string,
  //   /// The path to the built output.
  //   path: string,
  // }

  /// The report returned by the build operation.
  record build-report {
    /// The status of the operation.
    status: status,
    /// The findings from the operation.
    findings: list<finding>,
    // /// The outputs from the operation.
    //outputs: list<build-output>,
  }

  /// Request to merge a built slice into the project's codebase.
  record merge-request {
    /// The slice being merged.
    slice: string,
  }

  /// Request to target adapter to get information about the "shape" of build artifacts expected by
  /// the adapter. The returned shape is a prose from the adapter's shape.md brief.
  get-shape: func() -> result<string, error>;

  build: func(req: build-request) -> result<build-report, error>;
  merge: func(req: merge-request) -> result<_, error>;
}

world source-adapter {
  import wasi:filesystem/preopens@0.2.0;
}

world target-adapter {
  import wasi:filesystem/preopens@0.2.0;
  export target;
}

world workflow {
  import target;
  import source;


  // Note: the specific execution interface (e.g. `execute`)
  // can be defined and exported here as needed by the workflow design.
}

