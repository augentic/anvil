package augentic:specify@1.0.0;

interface types {
  // The error returned by operations.
  variant adapter-error {
    invalid-request(string),
    io(string),
    internal(string)
  }

  // ------------------------------------------------------
  // Source survey
  // ------------------------------------------------------

  // Request to survey a source.
  record survey-request {
    // The source being surveyed.
    source: string,
  }

  // The lead returned by the survey operation.
  record lead {
    // The lead's unique identifier.
    lead: string,
    // The source that surfaced the lead.
    source: string,
    // A reconciliation-grade per-source headline of the lead as this source surfaced it.
    synopsis: string,
    // Optional agent-authored per-lead topic slugs (kebab-case).
    topics: list<string>,
  }

  // ------------------------------------------------------
  // Source extract
  // ------------------------------------------------------

  // Request to extract evidence from a source.
  record extract-request {
    // The slice being extracted (path identity for the Evidence).
    slice-name: string,
    // The source that surfaced the leads.
    source: string,
    // The leads bound to this slice.
    leads: list<string>,
  }

  // The evidence's "authority", i.e. how seriously to take the evidence.
  enum authority { intent, documentation, behaviour }

  // The data for an example claim.
  record example-data {
    input: option<string>,
    output: option<string>,
  }

  // The specific detail for the kind of claim being extracted.
  variant claim-detail {
    intent(option<string>),
    requirement(option<string>),
    criterion(option<string>),
    decision(option<string>),
    section(option<string>),
    diagram(option<string>),
    contract(option<string>),
    example(example-data),
    excerpt(option<string>),
    %type(option<string>),
    call(option<string>),
    region(option<string>),
    container(option<string>),
    leaf(option<string>),
  }

  // A claim extracted from the source.
  record claim {
    // The claim's unique identifier.
    id: option<string>,
    // The claim's path in the source.
    path: option<string>,
    // The claim's replay digest.
    replay-digest: option<string>,
    // The detail specific to the claim's kind.
    detail: claim-detail,
  }

  // The evidence returned by the extract operation.
  record evidence {
    // The evidence's "authority", i.e. how seriously to take the evidence.
    authority: authority,
    // The lead that the evidence is bound to.
    lead: string,
    // The claims extracted from the source.
    claims: list<claim>,
  }

  // ------------------------------------------------------
  // Target shape
  // ------------------------------------------------------

  // Request to shape a slice.
  record shape-request {
    // The slice being shaped.
    slice-name: string,
  }

  // The severity of a finding.
  enum severity {
    critical,
    important,
    suggestion,
    optional
  }

  // A finding from the operation.
  record finding {
    // The finding's rule identifier.
    rule-id: string,
    // The severity of the finding.
    severity: severity,
    // The detail of the finding.
    detail: string,
  }

  // The status of the operation.
  enum build-status {
    success,
    failure,
  }

  record build-output {
    // The platform being built.
    platform: string,
    // The path to the built output.
    path: string,
  }

  record build-report {
    // The slice being built.
    slice-name: string,
    // The status of the operation.
    status: build-status,
    // The findings from the operation.
    findings: list<finding>,
    // The outputs from the operation.
    outputs: list<build-output>,
  }

  // The report returned by the shape operation.
  type shape-report = build-report;

  // ------------------------------------------------------
  // Target build
  // ------------------------------------------------------

  // Request to build a slice.
  record build-request {
    // The slice being built.
    slice-name: string,
    // The inputs to the build.
    inputs: list<tuple<string, string>>,
  }

  // ------------------------------------------------------
  // Target merge
  // ------------------------------------------------------

  // Request to merge a built slice into the project's codebase.
  record merge-request {
    // The slice being merged.
    slice-name: string,
  }

  // The report returned by the merge operation.
  type merge-report = build-report;
}

// ------------------------------------------------------
// Target and Source interfaces — the typed operation signatures a
// `tool` component exports. Capability params (project / slice handles)
// are deferred to RFC-52, which promotes them from a raw grant into
// named host-data effects; until then `tool` operations reach host data
// through the existing preopen / $CAPABILITY_DIR grant.
// ------------------------------------------------------

interface target {
  use types.{
    shape-request, shape-report,
    build-request, build-report,
    merge-request, merge-report,
    adapter-error
  };

  shape: func(req: shape-request) -> result<shape-report, adapter-error>;
  build: func(req: build-request) -> result<build-report, adapter-error>;
  merge: func(req: merge-request) -> result<merge-report, adapter-error>;
}

interface source {
  use types.{ survey-request, lead, extract-request, evidence, adapter-error };

  survey: func(req: survey-request) -> result<list<lead>, adapter-error>;
  extract: func(req: extract-request) -> result<evidence, adapter-error>;
}

// Agent-only today: both source operations are brief-bound, so this world
// exports nothing callable yet. The source adapter still ships a component
// (the composite's wasm half); it gains exports only when a deterministic
// source tool is written.
world source-adapter {}

world target-adapter {
  // Host-capability imports are deferred to RFC-52 (named host-data
  // effects); until then `tool` operations use the existing
  // preopen / $CAPABILITY_DIR grant.
  export target;   // only the operations this component implements
}

